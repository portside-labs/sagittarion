{
  "name": "sagittarion",
  "productName": "Sagittarion",
  "version": "0.12.0",
  "description": "AI-native database GUI for SQLite and PostgreSQL that protects PII",
  "main": "./out/main/index.js",
  "author": {
    "name": "Portside Labs LLC",
    "email": "hello@portsidelabs.io",
    "url": "https://portsidelabs.io"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "npm run build && node test/e2e/run.mjs",
    "test:e2e:model": "npm run build && node test/e2e/semantic.mjs",
    "dev:server": "node test/mock-ssh/server.mjs --port 2222",
    "dist": "electron-vite build && electron-builder",
    "test:docker": "DOCKER_TESTS=1 vitest run test/docker.test.ts",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-sql": "^6.9.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.1",
    "@lezer/highlight": "^1.2.4",
    "codemirror": "^6.0.2",
    "onnxruntime-node": "^1.30.0",
    "pg": "^8.23.0",
    "pg-cursor": "^2.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ssh2": "^1.16.0",
    "style-mod": "^4.1.4",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/pg-cursor": "^2.7.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "playwright": "^1.54.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "io.portsidelabs.sagittarion",
    "productName": "Sagittarion",
    "copyright": "Copyright © 2026 Portside Labs LLC",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/cpu-features/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/!(${platform})/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/${platform}/!(${arch})/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin/*/libonnxruntime.*.*.*.dylib",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/*/libonnxruntime_providers_*",
      "!node_modules/onnxruntime-node/script/**"
    ],
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ],
    "npmRebuild": false,
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "darkModeSupport": true
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "homepage": "https://portsidelabs.io/sagittarion"
}
